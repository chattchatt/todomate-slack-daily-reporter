# Required
TODOMATE_SLACK_CHANNEL_ID=D1234567890
MCPORTER_CREDENTIALS_JSON_B64=base64-encoded-mcporter-credentials-json
AGENT_MESSENGER_SLACK_CREDENTIALS_JSON_B64=base64-encoded-agent-messenger-slack-credentials-json

# Runtime
TODOMATE_RUN_MODE=auto
TODOMATE_FORCE=0
TODOMATE_TIMEZONE=Asia/Seoul
TODOMATE_STATE_DIR=/data/state
TODOMATE_LOG_DIR=/data/logs
TODOMATE_SCHEDULE_TOLERANCE_MINUTES=10

# Optional comma-separated TodoMate categories/goals to exclude from reports.
# Example: STUDY,LIFE,PERSONAL
TODOMATE_EXCLUDED_GOALS=

# Optional Redis/Postgres-style external state is not required for the single-user Railway setup.
# If TODOMATE_REDIS_URL or REDIS_URL is set, the script also stores state in Redis.
TODOMATE_REDIS_URL=

# Health check
TODOMATE_HERMES_HEALTHCHECK=1
TODOMATE_HERMES_FORCE_ALERT=0
